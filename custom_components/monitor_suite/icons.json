{
  "entity": {
    "sensor": {
      "status": {
        "default": "mdi:help-circle",
        "state": {
          "ok": "mdi:check-circle",
          "warning": "mdi:alert-circle",
          "critical": "mdi:alert-octagon"
        }
      },
      "cpu_usage": {
        "default": "mdi:cpu-64-bit"
      },
      "memory_usage": {
        "default": "mdi:memory"
      },
      "storage_usage": {
        "default": "mdi:harddisk",
        "range": {
          "90": "mdi:alert-circle"
        }
      },
      "power": {
        "default": "mdi:flash"
      },
      "input_voltage": {
        "default": "mdi:sine-wave"
      },
      "fan_speed": {
        "default": "mdi:fan-off",
        "range": {
          "1": "mdi:fan"
        }
      },
      "network_download": {
        "default": "mdi:download-network"
      },
      "network_upload": {
        "default": "mdi:upload-network"
      },
      "disk_read": {
        "default": "mdi:database-arrow-down"
      },
      "disk_write": {
        "default": "mdi:database-arrow-up"
      },
      "last_boot": {
        "default": "mdi:restart"
      },
      "raid_status": {
        "default": "mdi:harddisk",
        "state": {
          "healthy": "mdi:harddisk",
          "degraded": "mdi:alert-circle",
          "failed": "mdi:harddisk-remove",
          "recovering": "mdi:progress-wrench",
          "resyncing": "mdi:sync",
          "checking": "mdi:magnify-scan",
          "reshaping": "mdi:swap-horizontal"
        }
      },
      "smart_status": {
        "default": "mdi:harddisk",
        "state": {
          "healthy": "mdi:harddisk",
          "warning": "mdi:alert-circle",
          "failed": "mdi:harddisk-remove",
          "testing": "mdi:magnify-scan"
        }
      },
      "network_status": {
        "default": "mdi:lan-disconnect",
        "state": {
          "up": "mdi:lan-connect",
          "down": "mdi:lan-disconnect"
        }
      }
    }
  }
}
